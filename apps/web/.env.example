# Copy to apps/web/.env for local development. Never commit real secrets.
# On Vercel, set these in Project Settings → Environment Variables (Production).

# Pooled Postgres URL. Local example:
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/nobleza_hotel"

# Use a random 32+ character string in production. Never reuse the local value.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-32+"

# Public site URL. Locally this is http://localhost:3001.
# In production use the HTTPS production domain, for example https://nobleza-hotel.vercel.app
# (or your custom domain). BETTER_AUTH_URL and CORS_ORIGIN should match that URL.
BETTER_AUTH_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3001"
# Optional comma-separated extra origins for auth
# TRUSTED_ORIGINS="http://localhost:3000"

# Must match the ESP32 device key in the gitignored IoT_ESP32/**/secrets.h.
HOTEL_ESP32_SECRET="replace-with-a-device-key"

# Optional: email staff welcome messages and password-reset links.
# SMTP_USER=""
# SMTP_PASS=""

# Protects GET /api/cron/auto-vacancy. Required in production.
# Vercel Cron automatically sends Authorization: Bearer <CRON_SECRET> when this is set.
# Use at least 16 random characters.
# CRON_SECRET=""

# Optional public URL used in emails if different from BETTER_AUTH_URL.
# APP_URL="https://your-production-domain"

NODE_ENV="development"
