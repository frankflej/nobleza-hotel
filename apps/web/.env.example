# Copy to apps/web/.env for local development. Never commit real secrets.

DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/nobleza_hotel"

# Use a random 32+ character string in production.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-32+"
BETTER_AUTH_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3001"
# Optional comma-separated extra origins for auth
# TRUSTED_ORIGINS="http://localhost:3000"

# Must match the ESP32 device key (set in gitignored secrets.h).
HOTEL_ESP32_SECRET="replace-with-a-device-key"


# Optional: only needed to email new staff and password-reset links.
# SMTP_USER=""
# SMTP_PASS=""

# Optional: protects /api/cron/* in production.
# CRON_SECRET=""

# APP_URL="https://your-production-domain"
NODE_ENV="development"
