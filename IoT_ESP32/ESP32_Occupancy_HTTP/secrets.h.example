#ifndef NOBLEZA_SECRETS_H
#define NOBLEZA_SECRETS_H

// Copy this file to secrets.h (gitignored) and fill in real values.
// Never commit secrets.h.
// This variant is for local/LAN testing only. For Vercel, use the primary
// HTTPS sketch in IoT_ESP32/ESP32_Occupancy.

const char* WIFI_SSID = "YOUR_WIFI_SSID";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// Use your computer's LAN IP, not localhost, when flashing a physical board.
// The Next.js app listens on port 3001 in development.
const char* SERVER_URL = "http://YOUR_SERVER_HOST:3001/api/iot/occupancy";

// Must match HOTEL_ESP32_SECRET in apps/web/.env.
const char* DEVICE_KEY = "YOUR_HOTEL_ESP32_SECRET";

const char* ROOM_NUMBER = "101";

#endif
